# StackSense optional settings. The engine needs none of these: with the
# defaults below it runs fully offline and deterministically.
# Copy to .env only if you want the optional LLM helper.

# The LLM feature is optional and off by default. It can only suggest fields
# from project.description or reword explanations; the recommended stack is
# identical with it on or off. Values: off | on
STACKSENSE_LLM=off

# Provider used when STACKSENSE_LLM=on.
STACKSENSE_LLM_PROVIDER=gemini

# API key for the provider (free-tier key). Leave empty when the LLM is off.
GEMINI_API_KEY=

# Model name override. Empty = use the built-in default.
STACKSENSE_LLM_MODEL=

# Port for the local web UI (python -m stacksense serve).
STACKSENSE_PORT=8765
